# Maintainer: pompon0

pkgname=qwen-box-git
pkgver=r0.g0000000
pkgrel=2
pkgdesc='Rootless Qwen Code sandbox with restricted filesystem and network access'
arch=('x86_64')
url='https://github.com/pompon0/pompon0-qwen'
# Replace when the upstream project has a license.
license=('unknown')
depends=('bash' 'podman' 'nftables' 'coreutils' 'glibc' 'iproute2' 'nodejs>=22' 'npm')
# Arch's go package uses epoch 2. Do not silently download another toolchain.
makedepends=('git' 'go>=2:1.27.3')
provides=('qwen-box')
conflicts=('qwen-box')
options=('!debug' '!lto')
source=("qwen-box::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/qwen-box"
  printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

# Keep all Go state in makepkg's workspace, away from the builder's shared
# dependencies and tools. Each phase runs independently, so set it every time.
_go_environment() {
  export GOPATH="$srcdir/go"
  export GOMODCACHE="$GOPATH/pkg/mod"
  export GOCACHE="$srcdir/go-build"
  export GOTOOLCHAIN=local
  export GOENV=off
  export CGO_ENABLED=1
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS='-trimpath -mod=readonly -modcacherw'
}

prepare() {
  cd "$srcdir/qwen-box"
  _go_environment
  go mod download
}

build() {
  cd "$srcdir/qwen-box"
  _go_environment
  go build -buildmode=pie -ldflags='-linkmode=external' -o qwen-box .
}

check() {
  cd "$srcdir/qwen-box"
  _go_environment
  go test ./...
  go vet ./...
}

package() {
  cd "$srcdir/qwen-box"
  install -Dm755 qwen-box "$pkgdir/usr/bin/qwen-box"
  install -Dm644 README.md "$pkgdir/usr/share/doc/qwen-box/README.md"
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}

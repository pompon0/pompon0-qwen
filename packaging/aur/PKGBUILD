# Maintainer: pompon0

pkgname=qwen-isolated-git
pkgver=r0.g0000000
pkgrel=1
pkgdesc='Rootless Qwen Code sandbox with restricted filesystem and network access'
arch=('x86_64')
url='https://github.com/pompon0/pompon0-qwen'
# Replace when the upstream project has a license.
license=('unknown')
depends=('bash' 'bubblewrap' 'coreutils' 'glibc' 'iproute2' 'util-linux')
# Arch's go package uses epoch 2. Do not silently download another toolchain.
makedepends=('git' 'go>=2:1.27.3')
optdepends=('nodejs: Node.js runtime, as an alternative to a user-managed nvm installation')
provides=('qwen-isolated')
conflicts=('qwen-isolated')
options=('!debug' '!lto')
source=("qwen-isolated::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/qwen-isolated"
  printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

# Keep all Go state in makepkg's workspace, away from the builder's shared
# dependencies and tools. Each phase runs independently, so set it every time.
_go_environment() {
  export GOPATH="$srcdir/go"
  export GOMODCACHE="$GOPATH/pkg/mod"
  export GOCACHE="$srcdir/go-build"
  export GOTOOLCHAIN=local
  export GOENV=off
  export CGO_ENABLED=1
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS='-trimpath -mod=readonly -modcacherw'
}

prepare() {
  cd "$srcdir/qwen-isolated"
  _go_environment
  go mod download
}

build() {
  cd "$srcdir/qwen-isolated"
  _go_environment
  go build -buildmode=pie -ldflags='-linkmode=external' -o qwen-isolated .
}

check() {
  cd "$srcdir/qwen-isolated"
  _go_environment
  go test ./...
  go vet ./...
}

package() {
  cd "$srcdir/qwen-isolated"
  install -Dm755 qwen-isolated "$pkgdir/usr/bin/qwen-isolated"
  install -Dm644 README.md "$pkgdir/usr/share/doc/qwen-isolated/README.md"
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
